
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Muralidharan & Santhalakshmi | Engagement</title>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Great+Vibes&family=Playfair+Display&display=swap" rel="stylesheet">

<style>
* { box-sizing:border-box; margin:0; padding:0; }

body {
  background:#25070d;
  color:#f8e6bd;
  font-family:'Playfair Display',serif;
  text-align:center;
  overflow-x:hidden;
}

section {
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  padding:55px 20px;
  position:relative;
  border-bottom:1px solid #9d713b;
}

section::before {
  content:"";
  position:absolute;
  inset:13px;
  border:1px solid #c9a45b;
  pointer-events:none;
}

.hero {
  background:
  linear-gradient(#25070dcc,#25070dcc),
  radial-gradient(ellipse at center,#79321d,#25070d);
}

.om {
  font-size:65px;
  color:#e6b85c;
  margin-bottom:20px;
  animation:glow 3s infinite alternate;
}

h1 {
  font-family:'Great Vibes',cursive;
  font-size:clamp(48px,9vw,90px);
  color:#f4d18b;
  font-weight:400;
  margin:15px 0;
}

h2 {
  font-family:'Cinzel',serif;
  font-size:clamp(23px,5vw,38px);
  color:#e9c77d;
  margin:20px;
}

.subtitle {
  letter-spacing:5px;
  font-size:13px;
  color:#e9c77d;
  margin:15px;
}

.divider {
  color:#e5b45e;
  font-size:30px;
  margin:20px;
}

.names {
  font-family:'Great Vibes',cursive;
  font-size:clamp(45px,8vw,76px);
  color:#fff0cb;
  line-height:1.5;
}

.card {
  border:1px solid #c79a50;
  padding:35px 25px;
  max-width:650px;
  width:100%;
  background:#4a101c99;
  box-shadow:0 0 35px #0008;
}

.details {
  line-height:2.2;
  font-size:18px;
}

.gold { color:#e9c77d; }

button, .map-button {
  padding:14px 28px;
  border:1px solid #e9c77d;
  background:#9a5427;
  color:white;
  font-family:inherit;
  font-size:16px;
  text-decoration:none;
  cursor:pointer;
  display:inline-block;
  margin-top:25px;
  transition:.3s;
}

button:hover, .map-button:hover {
  background:#d5a653;
  color:#350b12;
}

.countdown {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:15px;
  margin:30px 0;
}

.time {
  border:1px solid #c79a50;
  padding:18px 14px;
  min-width:85px;
  background:#501320;
}

.time strong {
  display:block;
  font-size:30px;
  color:#f5d68e;
}

.time span {
  font-size:12px;
  letter-spacing:2px;
}

.petals {
  position:fixed;
  top:-30px;
  z-index:10;
  pointer-events:none;
  animation:fall linear infinite;
}

@keyframes fall {
  to { transform:translateY(110vh) rotate(720deg); }
}

@keyframes glow {
  from { text-shadow:0 0 10px #d49b40; }
  to { text-shadow:0 0 35px #ffcc70; }
}

.fade {
  animation:appear 2s ease both;
}

@keyframes appear {
  from {opacity:0;transform:translateY(35px);}
  to {opacity:1;transform:translateY(0);}
}

footer {
  padding:35px 15px;
  color:#d7b777;
  letter-spacing:2px;
  font-size:12px;
}
</style>
</head>

<body>

<section class="hero">
  <div class="fade">
    <div class="om">ॐ</div>
    <p class="subtitle">॥ WITH THE BLESSINGS OF GOD & OUR FAMILIES ॥</p>
    <div class="divider">❀ ❖ ❀</div>
    <h1>You're Invited</h1>
    <h2>TO OUR ENGAGEMENT</h2>
    <div class="divider">✦</div>
    <p class="subtitle">TWO HEARTS • ONE BEAUTIFUL BEGINNING</p>
    <button onclick="document.getElementById('couple').scrollIntoView({behavior:'smooth'})">
      Open Invitation ♥
    </button>
  </div>
</section>

<section id="couple">
  <div class="fade">
    <p class="subtitle">A PROMISE OF FOREVER</p>
    <h2>THE CELEBRATION OF LOVE</h2>
    <div class="divider">❀</div>
    <div class="names">Muralidharan K</div>
    <h2>&</h2>
    <div class="names">Santhalakshmi J</div>
    <div class="divider">❀</div>
    <p class="details">
      Two families, two hearts and one beautiful journey.<br>
      We invite you to celebrate the beginning of our forever.
    </p>
  </div>
</section>

<section>
  <div class="card fade">
    <p class="subtitle">SAVE THE DATE</p>
    <h1>20 June 2027</h1>
    <div class="divider">✦ ❀ ✦</div>
    <h2>Sunday | 6 PM – 8 PM</h2>
    <p class="details">Your presence is our greatest blessing.</p>

    <h2 class="gold">COUNTDOWN TO FOREVER</h2>
    <div class="countdown">
      <div class="time"><strong id="days">00</strong><span>DAYS</span></div>
      <div class="time"><strong id="hours">00</strong><span>HOURS</span></div>
      <div class="time"><strong id="minutes">00</strong><span>MINUTES</span></div>
      <div class="time"><strong id="seconds">00</strong><span>SECONDS</span></div>
    </div>
  </div>
</section>

<section>
  <div class="card fade">
    <p class="subtitle">JOIN US FOR OUR SPECIAL DAY</p>
    <h1>Venue</h1>
    <div class="divider">❀</div>
    <h2>RK MAHAL</h2>
    <p class="details">
      Bharathi Nagar,<br>
      Kempatty Colony,<br>
      Town Hall,<br>
      Coimbatore,<br>
      Tamil Nadu – 641001
    </p>
    <a class="map-button"
       href="https://www.google.com/maps/search/?api=1&query=RK+Mahal+Bharathi+Nagar+Kempatty+Colony+Town+Hall+Coimbatore+Tamil+Nadu+641001"
       target="_blank">
       Get Directions ↗
    </a>
  </div>
</section>

<section>
  <div class="fade">
    <div class="om">❀</div>
    <p class="subtitle">YOUR PRESENCE WILL MAKE OUR DAY SPECIAL</p>
    <h1>With Love</h1>
    <div class="names">Muralidharan</div>
    <h2>&</h2>
    <div class="names">Santhalakshmi</div>
    <div class="divider">♥</div>
    <p class="subtitle">20 • 06 • 2027</p>
    <h2>WE CAN'T WAIT TO CELEBRATE WITH YOU!</h2>
  </div>
</section>

<footer>
  MADE WITH LOVE ♥ <br><br>
  MURALIDHARAN & SANTHALAKSHMI
</footer>

<script>
const target = new Date("2027-06-20T18:00:00+05:30").getTime();

function updateCountdown() {
  let distance = target - Date.now();
  distance = Math.max(0, distance);

  document.getElementById("days").textContent =
    Math.floor(distance / 86400000);

  document.getElementById("hours").textContent =
    Math.floor((distance % 86400000) / 3600000);

  document.getElementById("minutes").textContent =
    Math.floor((distance % 3600000) / 60000);

  document.getElementById("seconds").textContent =
    Math.floor((distance % 60000) / 1000);
}

setInterval(updateCountdown,1000);
updateCountdown();

// Falling rose petals
for(let i=0;i<22;i++){
  let petal=document.createElement("div");
  petal.className="petals";
  petal.textContent="🌸";
  petal.style.left=Math.random()*100+"vw";
  petal.style.animationDuration=(7+Math.random()*10)+"s";
  petal.style.animationDelay=(-Math.random()*15)+"s";
  petal.style.fontSize=(12+Math.random()*15)+"px";
  document.body.appendChild(petal);
}
</script>

</body>
</html>
